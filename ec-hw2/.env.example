# Copy this file to ec-hw2/.env and fill in the values.
# Mac/Linux:  cp ec-hw2/.env.example ec-hw2/.env
# Windows:    copy ec-hw2\.env.example ec-hw2\.env      (check the name is ".env", not ".env.txt")
# Never commit ec-hw2/.env to git.

# Local databases (docker compose)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=truthlag
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-at-least-8-chars

# MongoDB Atlas free tier (M0). Ask the Data+MongoDB owner for the read-only user.
ATLAS_URI=
ATLAS_DB=truthlag

# Sharded demo (ec-hw2/scaleout/docker-compose.sharded.yml)
SHARDED_URI=mongodb://localhost:27020

# Optional: Neo4j Aura Free copy (contested subgraph only; Aura Free has no GDS)
NEO4J_AURA_URI=
NEO4J_AURA_USER=neo4j
NEO4J_AURA_PASSWORD=

# Secret for the editor pseudonyms (editor_<hex>). Ask Scott for the team value, so your
# notebooks show the same pseudonyms as the committed results. Never commit it.
ALIAS_SECRET=
