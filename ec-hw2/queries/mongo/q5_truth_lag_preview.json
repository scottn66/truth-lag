{
  "collection": "revisions",
  "description": "Mongo Q5 (spec 3.5), the truth-lag preview: live-stream signals vs the eventual revert label. It starts from revisions (both cohorts). An equality $lookup on rev_id = revert_links.reverted_rev_id (same cohort) gives T (time to revert) and, for the live cohort, K (stream delay). Eventual revert = T <= 345600 s (4 days, the horizon both cohorts share; self-reverts count). known_by = T + K for live (when the stream showed the revert) and T for history (the dump has no stream delay). Part 'known_by': for each cohort and user kind (and 'all'), the share of eventual reverts already known after each wait ['0', '1 min', '5 min', '15 min', '1 h', '6 h', '1 d', '2 d', '4 d']; groups with fewer than 100 eventual reverts are dropped. Part 'activity': the revert rate by the page's edits in the hour before the edit, with two measures (column source). source = 'page_hour', live only: a second $lookup reads page_hour (the speed layer) for the clock hour before the edit was seen; the edits earlier in the same clock hour are not in it. source = 'prev_1h', both cohorts: the sliding hour [t - 1 h, t) stored in the document (history.page_edits_prev_1h from the dump; live.page_edits_prev_1h from the stream). page_hour does not exist for September, so compare the cohorts with 'prev_1h' only. Groups with fewer than 100 edits are dropped. The stream labels of the live cohort are provisional until 2026-10-27T00:05:00+00:00. Atlas holds the history cohort only. How to run it by hand: in Atlas, open Data Explorer, pick the database 'truthlag' and the collection 'revisions', open the Aggregations tab, switch to the text view (the '</>' button) and paste the 'pipeline' array. In MongoDB Compass: open the collection 'revisions', Aggregations, Text, then paste the array. In mongosh: db.revisions.aggregate(<pipeline>). Do not edit this file by hand: queries/run_mongo.py writes it from config.py.",
  "pipeline": [
    {"$match": {"cohort": {"$in": ["history", "live"]}}},
    {
      "$lookup": {
        "from": "revert_links",
        "localField": "rev_id",
        "foreignField": "reverted_rev_id",
        "let": {"c": "$cohort"},
        "pipeline": [
          {"$match": {"$expr": {"$eq": ["$cohort", "$$c"]}}},
          {"$project": {"_id": 0, "T_s": 1, "K_s": 1}}
        ],
        "as": "link"
      }
    },
    {
      "$addFields": {
        "prev_hour_key": {
          "$cond": [
            {"$eq": ["$cohort", "live"]},
            {
              "$concat": [
                {"$toString": "$page.id"},
                ":",
                {
                  "$dateToString": {
                    "date": {
                      "$dateSubtract": {"startDate": "$live.seen_ts", "unit": "hour", "amount": 1}
                    },
                    "format": "%Y-%m-%dT%H",
                    "timezone": "UTC"
                  }
                }
              ]
            },
            null
          ]
        }
      }
    },
    {
      "$lookup": {
        "from": "page_hour",
        "localField": "prev_hour_key",
        "foreignField": "_id",
        "as": "prev_hour"
      }
    },
    {
      "$project": {
        "_id": 0,
        "cohort": 1,
        "user_kind": "$user.kind",
        "risk": "$live.revert_risk",
        "T": {"$first": "$link.T_s"},
        "K": {"$first": "$link.K_s"},
        "prev_clock_hour": {
          "$cond": [
            {"$eq": ["$cohort", "live"]},
            {"$ifNull": [{"$first": "$prev_hour.edits_seen"}, 0]},
            null
          ]
        },
        "prev_1h": {"$ifNull": ["$live.page_edits_prev_1h", "$history.page_edits_prev_1h"]}
      }
    },
    {
      "$addFields": {
        "rev_4d": {"$and": [{"$gte": ["$T", 0]}, {"$lte": ["$T", 345600]}]},
        "known_by": {"$add": ["$T", {"$ifNull": ["$K", 0]}]}
      }
    },
    {
      "$facet": {
        "known_by": [
          {"$addFields": {"kinds": ["$user_kind", "all"]}},
          {"$unwind": "$kinds"},
          {
            "$group": {
              "_id": {"cohort": "$cohort", "user_kind": "$kinds"},
              "n_edits": {"$sum": 1},
              "n_reverted_4d": {"$sum": {"$cond": ["$rev_4d", 1, 0]}},
              "known_0": {
                "$sum": {"$cond": [{"$and": ["$rev_4d", {"$lte": ["$known_by", 0]}]}, 1, 0]}
              },
              "known_1": {
                "$sum": {"$cond": [{"$and": ["$rev_4d", {"$lte": ["$known_by", 60]}]}, 1, 0]}
              },
              "known_2": {
                "$sum": {"$cond": [{"$and": ["$rev_4d", {"$lte": ["$known_by", 300]}]}, 1, 0]}
              },
              "known_3": {
                "$sum": {"$cond": [{"$and": ["$rev_4d", {"$lte": ["$known_by", 900]}]}, 1, 0]}
              },
              "known_4": {
                "$sum": {"$cond": [{"$and": ["$rev_4d", {"$lte": ["$known_by", 3600]}]}, 1, 0]}
              },
              "known_5": {
                "$sum": {"$cond": [{"$and": ["$rev_4d", {"$lte": ["$known_by", 21600]}]}, 1, 0]}
              },
              "known_6": {
                "$sum": {"$cond": [{"$and": ["$rev_4d", {"$lte": ["$known_by", 86400]}]}, 1, 0]}
              },
              "known_7": {
                "$sum": {"$cond": [{"$and": ["$rev_4d", {"$lte": ["$known_by", 172800]}]}, 1, 0]}
              },
              "known_8": {
                "$sum": {"$cond": [{"$and": ["$rev_4d", {"$lte": ["$known_by", 345600]}]}, 1, 0]}
              }
            }
          },
          {"$match": {"n_reverted_4d": {"$gte": 100}}},
          {
            "$project": {
              "_id": 0,
              "cohort": "$_id.cohort",
              "user_kind": "$_id.user_kind",
              "n_edits": 1,
              "n_reverted_4d": 1,
              "waits": [
                {"wait": "0", "wait_s": 0, "wait_sorted": "01 0", "known": "$known_0"},
                {"wait": "1 min", "wait_s": 60, "wait_sorted": "02 1 min", "known": "$known_1"},
                {"wait": "5 min", "wait_s": 300, "wait_sorted": "03 5 min", "known": "$known_2"},
                {"wait": "15 min", "wait_s": 900, "wait_sorted": "04 15 min", "known": "$known_3"},
                {"wait": "1 h", "wait_s": 3600, "wait_sorted": "05 1 h", "known": "$known_4"},
                {"wait": "6 h", "wait_s": 21600, "wait_sorted": "06 6 h", "known": "$known_5"},
                {"wait": "1 d", "wait_s": 86400, "wait_sorted": "07 1 d", "known": "$known_6"},
                {"wait": "2 d", "wait_s": 172800, "wait_sorted": "08 2 d", "known": "$known_7"},
                {"wait": "4 d", "wait_s": 345600, "wait_sorted": "09 4 d", "known": "$known_8"}
              ]
            }
          },
          {"$unwind": "$waits"},
          {
            "$project": {
              "cohort": 1,
              "user_kind": 1,
              "wait": "$waits.wait",
              "wait_s": "$waits.wait_s",
              "wait_sorted": "$waits.wait_sorted",
              "n_edits": 1,
              "n_reverted_4d": 1,
              "revert_rate_4d": {"$divide": ["$n_reverted_4d", "$n_edits"]},
              "known": "$waits.known",
              "share_known": {"$divide": ["$waits.known", "$n_reverted_4d"]}
            }
          },
          {"$sort": {"cohort": 1, "user_kind": 1, "wait_s": 1}}
        ],
        "activity": [
          {
            "$project": {
              "cohort": 1,
              "rev_4d": 1,
              "measure": {
                "$cond": [
                  {"$eq": ["$cohort", "live"]},
                  [
                    {"source": "page_hour", "edits": "$prev_clock_hour"},
                    {"source": "prev_1h", "edits": "$prev_1h"}
                  ],
                  [{"source": "prev_1h", "edits": "$prev_1h"}]
                ]
              }
            }
          },
          {"$unwind": "$measure"},
          {
            "$group": {
              "_id": {
                "cohort": "$cohort",
                "source": "$measure.source",
                "edge": {
                  "$switch": {
                    "branches": [
                      {"case": {"$lt": ["$measure.edits", 1]}, "then": 0},
                      {"case": {"$lt": ["$measure.edits", 2]}, "then": 1},
                      {"case": {"$lt": ["$measure.edits", 5]}, "then": 2},
                      {"case": {"$lt": ["$measure.edits", 10]}, "then": 5}
                    ],
                    "default": 10
                  }
                }
              },
              "n_edits": {"$sum": 1},
              "n_reverted_4d": {"$sum": {"$cond": ["$rev_4d", 1, 0]}}
            }
          },
          {"$match": {"n_edits": {"$gte": 100}}},
          {
            "$project": {
              "_id": 0,
              "cohort": "$_id.cohort",
              "source": "$_id.source",
              "prev_hour_edits": {
                "$arrayElemAt": [
                  ["0", "1", "2-4", "5-9", "10+"],
                  {"$indexOfArray": [[0, 1, 2, 5, 10], "$_id.edge"]}
                ]
              },
              "prev_hour_edits_from": "$_id.edge",
              "n_edits": 1,
              "n_reverted_4d": 1,
              "revert_rate_4d": {"$divide": ["$n_reverted_4d", "$n_edits"]}
            }
          },
          {"$sort": {"cohort": 1, "source": 1, "prev_hour_edits_from": 1}}
        ]
      }
    }
  ]
}
