{
  "collection": "revert_links",
  "description": "Mongo Q4 (spec 3.4): bot vs human share of reverts in the history cohort, with one $facet. Input: revert_links with within_followup and by_other (self-reverts removed). made_by_reverter_kind: revert actions (distinct reverting_rev_id) made by each reverter kind, and their share. received_by_author_kind: reverted revisions by author kind, and their share. edit_revert_rate: from revisions (an uncorrelated $lookup), the revert rate of bot edits vs human edits (human = not a bot, so it includes the few 'unknown' editors); reverted = history.reverted (within 20 days, any reverter) and reverted_by_other. The result is one document with three arrays. How to run it by hand: in Atlas, open Data Explorer, pick the database 'truthlag' and the collection 'revert_links', open the Aggregations tab, switch to the text view (the '</>' button) and paste the 'pipeline' array. In MongoDB Compass: open the collection 'revert_links', Aggregations, Text, then paste the array. In mongosh: db.revert_links.aggregate(<pipeline>). Do not edit this file by hand: queries/run_mongo.py writes it from config.py.",
  "pipeline": [
    {"$match": {"cohort": "history", "within_followup": true, "by_other": true}},
    {
      "$facet": {
        "made_by_reverter_kind": [
          {
            "$group": {
              "_id": {"kind": "$reverter_kind", "rev": "$reverting_rev_id"},
              "links": {"$sum": 1}
            }
          },
          {
            "$group": {
              "_id": "$_id.kind",
              "revert_actions": {"$sum": 1},
              "reverted_revisions": {"$sum": "$links"}
            }
          },
          {"$project": {"_id": 0, "kind": "$_id", "revert_actions": 1, "reverted_revisions": 1}},
          {"$setWindowFields": {"output": {"total": {"$sum": "$revert_actions"}}}},
          {"$addFields": {"share": {"$divide": ["$revert_actions", "$total"]}}},
          {"$project": {"total": 0}},
          {"$sort": {"revert_actions": -1, "kind": 1}}
        ],
        "received_by_author_kind": [
          {
            "$group": {
              "_id": "$author_kind",
              "reverted_revisions": {"$sum": 1},
              "rev_actions": {"$addToSet": "$reverting_rev_id"}
            }
          },
          {
            "$project": {
              "_id": 0,
              "kind": "$_id",
              "reverted_revisions": 1,
              "revert_actions": {"$size": "$rev_actions"}
            }
          },
          {"$setWindowFields": {"output": {"total": {"$sum": "$reverted_revisions"}}}},
          {"$addFields": {"share": {"$divide": ["$reverted_revisions", "$total"]}}},
          {"$project": {"total": 0}},
          {"$sort": {"reverted_revisions": -1, "kind": 1}}
        ],
        "edit_revert_rate": [
          {"$limit": 1},
          {
            "$lookup": {
              "from": "revisions",
              "pipeline": [
                {"$match": {"cohort": "history"}},
                {
                  "$group": {
                    "_id": {"$cond": ["$user.is_bot", "bot", "human"]},
                    "edits": {"$sum": 1},
                    "reverted": {"$sum": {"$cond": ["$history.reverted", 1, 0]}},
                    "reverted_by_other": {
                      "$sum": {
                        "$cond": [
                          {"$and": ["$history.reverted", "$history.reverted_by_other"]},
                          1,
                          0
                        ]
                      }
                    }
                  }
                },
                {
                  "$project": {
                    "_id": 0,
                    "kind": "$_id",
                    "edits": 1,
                    "reverted": 1,
                    "reverted_by_other": 1,
                    "revert_rate": {"$divide": ["$reverted", "$edits"]},
                    "revert_rate_by_other": {"$divide": ["$reverted_by_other", "$edits"]}
                  }
                },
                {"$sort": {"kind": 1}}
              ],
              "as": "rates"
            }
          },
          {"$unwind": "$rates"},
          {"$replaceRoot": {"newRoot": "$rates"}}
        ]
      }
    }
  ]
}
