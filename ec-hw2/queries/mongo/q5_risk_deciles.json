{
  "collection": "revisions",
  "description": "Mongo Q5 (spec 3.5), risk deciles: the LIVE cohort only (Atlas holds the history cohort only, so run it on the local database). It starts from revisions with the same stages as q5_truth_lag_preview ($lookup of revert_links for T and K, and of page_hour). Edits with a Wikimedia revert-risk score at save time are split into 10 groups of about equal size with $bucketAuto on live.revert_risk (_id.min and _id.max are the score range; the last group includes its max). A $unionWith adds one more group, 'no score': the revisions without a score. These are page creations (they never get a score; n_page_creations) and edits whose score event was not captured (n - n_page_creations). Per group: n, n_reverted_4d (T <= 345600 s, self-reverts count), the exact median T of those reverts ($push + $sortArray; $median in MongoDB 8.0 is only approximate), and for each wait w in ['now', '1 h', '1 d'] (index 0, 1, 2): at_risk_i = edits with T > w (never reverted counts as T = infinity) and event_i = those reverted within 4 days. queries/run_mongo.py then computes p = event_i / at_risk_i, the residual P(w < T <= 4 d | T > w), with a Wilson 95% interval in Python (run_mongo.wilson), and drops groups with n < 100. Provisional until 2026-10-27T00:05:00+00:00. How to run it by hand: in Atlas, open Data Explorer, pick the database 'truthlag' and the collection 'revisions', open the Aggregations tab, switch to the text view (the '</>' button) and paste the 'pipeline' array. In MongoDB Compass: open the collection 'revisions', Aggregations, Text, then paste the array. In mongosh: db.revisions.aggregate(<pipeline>). Do not edit this file by hand: queries/run_mongo.py writes it from config.py.",
  "pipeline": [
    {"$match": {"cohort": {"$in": ["live"]}, "live.revert_risk": {"$ne": null}}},
    {
      "$lookup": {
        "from": "revert_links",
        "localField": "rev_id",
        "foreignField": "reverted_rev_id",
        "let": {"c": "$cohort"},
        "pipeline": [
          {"$match": {"$expr": {"$eq": ["$cohort", "$$c"]}}},
          {"$project": {"_id": 0, "T_s": 1, "K_s": 1}}
        ],
        "as": "link"
      }
    },
    {
      "$addFields": {
        "prev_hour_key": {
          "$cond": [
            {"$eq": ["$cohort", "live"]},
            {
              "$concat": [
                {"$toString": "$page.id"},
                ":",
                {
                  "$dateToString": {
                    "date": {
                      "$dateSubtract": {"startDate": "$live.seen_ts", "unit": "hour", "amount": 1}
                    },
                    "format": "%Y-%m-%dT%H",
                    "timezone": "UTC"
                  }
                }
              ]
            },
            null
          ]
        }
      }
    },
    {
      "$lookup": {
        "from": "page_hour",
        "localField": "prev_hour_key",
        "foreignField": "_id",
        "as": "prev_hour"
      }
    },
    {
      "$project": {
        "_id": 0,
        "cohort": 1,
        "user_kind": "$user.kind",
        "risk": "$live.revert_risk",
        "T": {"$first": "$link.T_s"},
        "K": {"$first": "$link.K_s"},
        "prev_clock_hour": {
          "$cond": [
            {"$eq": ["$cohort", "live"]},
            {"$ifNull": [{"$first": "$prev_hour.edits_seen"}, 0]},
            null
          ]
        },
        "prev_1h": {"$ifNull": ["$live.page_edits_prev_1h", "$history.page_edits_prev_1h"]},
        "creation": {"$eq": [{"$ifNull": ["$parent_id", 0]}, 0]}
      }
    },
    {
      "$addFields": {
        "rev_4d": {"$and": [{"$gte": ["$T", 0]}, {"$lte": ["$T", 345600]}]},
        "known_by": {"$add": ["$T", {"$ifNull": ["$K", 0]}]}
      }
    },
    {
      "$project": {
        "risk": 1,
        "rev_4d": 1,
        "creation": 1,
        "T_inf": {"$ifNull": ["$T", 1e+18]},
        "T_rev": {"$cond": ["$rev_4d", "$T", null]}
      }
    },
    {
      "$bucketAuto": {
        "groupBy": "$risk",
        "buckets": 10,
        "output": {
          "n": {"$sum": 1},
          "n_reverted_4d": {"$sum": {"$cond": ["$rev_4d", 1, 0]}},
          "n_page_creations": {"$sum": {"$cond": ["$creation", 1, 0]}},
          "T_list": {"$push": "$T_rev"},
          "at_risk_0": {"$sum": {"$cond": [{"$gt": ["$T_inf", 0]}, 1, 0]}},
          "event_0": {"$sum": {"$cond": [{"$and": ["$rev_4d", {"$gt": ["$T_inf", 0]}]}, 1, 0]}},
          "at_risk_1": {"$sum": {"$cond": [{"$gt": ["$T_inf", 3600]}, 1, 0]}},
          "event_1": {"$sum": {"$cond": [{"$and": ["$rev_4d", {"$gt": ["$T_inf", 3600]}]}, 1, 0]}},
          "at_risk_2": {"$sum": {"$cond": [{"$gt": ["$T_inf", 86400]}, 1, 0]}},
          "event_2": {"$sum": {"$cond": [{"$and": ["$rev_4d", {"$gt": ["$T_inf", 86400]}]}, 1, 0]}}
        }
      }
    },
    {
      "$addFields": {
        "_sorted": {
          "$sortArray": {
            "input": {"$filter": {"input": "$T_list", "cond": {"$ne": ["$$this", null]}}},
            "sortBy": 1
          }
        }
      }
    },
    {"$addFields": {"_n": {"$size": "$_sorted"}}},
    {
      "$addFields": {
        "median_T_s": {
          "$switch": {
            "branches": [
              {"case": {"$eq": ["$_n", 0]}, "then": null},
              {
                "case": {"$eq": [{"$mod": ["$_n", 2]}, 1]},
                "then": {
                  "$arrayElemAt": ["$_sorted", {"$toInt": {"$floor": {"$divide": ["$_n", 2]}}}]
                }
              }
            ],
            "default": {
              "$avg": [
                {
                  "$arrayElemAt": [
                    "$_sorted",
                    {"$subtract": [{"$toInt": {"$floor": {"$divide": ["$_n", 2]}}}, 1]}
                  ]
                },
                {"$arrayElemAt": ["$_sorted", {"$toInt": {"$floor": {"$divide": ["$_n", 2]}}}]}
              ]
            }
          }
        }
      }
    },
    {"$project": {"_sorted": 0, "_n": 0, "T_list": 0}},
    {
      "$unionWith": {
        "coll": "revisions",
        "pipeline": [
          {"$match": {"cohort": {"$in": ["live"]}, "live.revert_risk": null}},
          {
            "$lookup": {
              "from": "revert_links",
              "localField": "rev_id",
              "foreignField": "reverted_rev_id",
              "let": {"c": "$cohort"},
              "pipeline": [
                {"$match": {"$expr": {"$eq": ["$cohort", "$$c"]}}},
                {"$project": {"_id": 0, "T_s": 1, "K_s": 1}}
              ],
              "as": "link"
            }
          },
          {
            "$addFields": {
              "prev_hour_key": {
                "$cond": [
                  {"$eq": ["$cohort", "live"]},
                  {
                    "$concat": [
                      {"$toString": "$page.id"},
                      ":",
                      {
                        "$dateToString": {
                          "date": {
                            "$dateSubtract": {
                              "startDate": "$live.seen_ts",
                              "unit": "hour",
                              "amount": 1
                            }
                          },
                          "format": "%Y-%m-%dT%H",
                          "timezone": "UTC"
                        }
                      }
                    ]
                  },
                  null
                ]
              }
            }
          },
          {
            "$lookup": {
              "from": "page_hour",
              "localField": "prev_hour_key",
              "foreignField": "_id",
              "as": "prev_hour"
            }
          },
          {
            "$project": {
              "_id": 0,
              "cohort": 1,
              "user_kind": "$user.kind",
              "risk": "$live.revert_risk",
              "T": {"$first": "$link.T_s"},
              "K": {"$first": "$link.K_s"},
              "prev_clock_hour": {
                "$cond": [
                  {"$eq": ["$cohort", "live"]},
                  {"$ifNull": [{"$first": "$prev_hour.edits_seen"}, 0]},
                  null
                ]
              },
              "prev_1h": {"$ifNull": ["$live.page_edits_prev_1h", "$history.page_edits_prev_1h"]},
              "creation": {"$eq": [{"$ifNull": ["$parent_id", 0]}, 0]}
            }
          },
          {
            "$addFields": {
              "rev_4d": {"$and": [{"$gte": ["$T", 0]}, {"$lte": ["$T", 345600]}]},
              "known_by": {"$add": ["$T", {"$ifNull": ["$K", 0]}]}
            }
          },
          {
            "$project": {
              "risk": 1,
              "rev_4d": 1,
              "creation": 1,
              "T_inf": {"$ifNull": ["$T", 1e+18]},
              "T_rev": {"$cond": ["$rev_4d", "$T", null]}
            }
          },
          {
            "$group": {
              "_id": "no score",
              "n": {"$sum": 1},
              "n_reverted_4d": {"$sum": {"$cond": ["$rev_4d", 1, 0]}},
              "n_page_creations": {"$sum": {"$cond": ["$creation", 1, 0]}},
              "T_list": {"$push": "$T_rev"},
              "at_risk_0": {"$sum": {"$cond": [{"$gt": ["$T_inf", 0]}, 1, 0]}},
              "event_0": {"$sum": {"$cond": [{"$and": ["$rev_4d", {"$gt": ["$T_inf", 0]}]}, 1, 0]}},
              "at_risk_1": {"$sum": {"$cond": [{"$gt": ["$T_inf", 3600]}, 1, 0]}},
              "event_1": {
                "$sum": {"$cond": [{"$and": ["$rev_4d", {"$gt": ["$T_inf", 3600]}]}, 1, 0]}
              },
              "at_risk_2": {"$sum": {"$cond": [{"$gt": ["$T_inf", 86400]}, 1, 0]}},
              "event_2": {
                "$sum": {"$cond": [{"$and": ["$rev_4d", {"$gt": ["$T_inf", 86400]}]}, 1, 0]}
              }
            }
          },
          {
            "$addFields": {
              "_sorted": {
                "$sortArray": {
                  "input": {"$filter": {"input": "$T_list", "cond": {"$ne": ["$$this", null]}}},
                  "sortBy": 1
                }
              }
            }
          },
          {"$addFields": {"_n": {"$size": "$_sorted"}}},
          {
            "$addFields": {
              "median_T_s": {
                "$switch": {
                  "branches": [
                    {"case": {"$eq": ["$_n", 0]}, "then": null},
                    {
                      "case": {"$eq": [{"$mod": ["$_n", 2]}, 1]},
                      "then": {
                        "$arrayElemAt": [
                          "$_sorted",
                          {"$toInt": {"$floor": {"$divide": ["$_n", 2]}}}
                        ]
                      }
                    }
                  ],
                  "default": {
                    "$avg": [
                      {
                        "$arrayElemAt": [
                          "$_sorted",
                          {"$subtract": [{"$toInt": {"$floor": {"$divide": ["$_n", 2]}}}, 1]}
                        ]
                      },
                      {
                        "$arrayElemAt": [
                          "$_sorted",
                          {"$toInt": {"$floor": {"$divide": ["$_n", 2]}}}
                        ]
                      }
                    ]
                  }
                }
              }
            }
          },
          {"$project": {"_sorted": 0, "_n": 0, "T_list": 0}}
        ]
      }
    }
  ]
}
