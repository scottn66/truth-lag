{
  "collection": "revert_links",
  "description": "Mongo Q3 (spec 3.3): the distribution of the time to revert T_s (seconds from the reverted revision to the reverting revision), for revert_links with within_followup. Three series (field cohort): 'history' = history reverts within 20 days; 'live' = live reverts within 4 days; 'history_4d' = the history reverts with T_s <= 345600 s (4 days), with the shares computed again on that smaller total. Compare 'live' with 'history_4d' (the same 4-day horizon), not with 'history'. The live T is also cut by the capture until 2026-10-27T00:05:00+00:00 (provisional). One $bucket per series inside a $facet, with the lag grid of config.py as boundaries [lower, upper). The default bucket 'over_20d' must stay empty (run_mongo.py asserts this). Output: cohort (series), bucket label, bucket_lower_s, bucket_upper_s, n, share of the series, cumulative share. Empty buckets are not listed. How to run it by hand: in Atlas, open Data Explorer, pick the database 'truthlag' and the collection 'revert_links', open the Aggregations tab, switch to the text view (the '</>' button) and paste the 'pipeline' array. In MongoDB Compass: open the collection 'revert_links', Aggregations, Text, then paste the array. In mongosh: db.revert_links.aggregate(<pipeline>). Do not edit this file by hand: queries/run_mongo.py writes it from config.py.",
  "pipeline": [
    {"$match": {"cohort": {"$in": ["history", "live"]}, "within_followup": true}},
    {
      "$facet": {
        "history": [
          {"$match": {"cohort": "history"}},
          {
            "$bucket": {
              "groupBy": "$T_s",
              "boundaries": [
                0,
                60,
                300,
                900,
                3600,
                21600,
                86400,
                172800,
                345600,
                604800,
                1209600,
                1728001
              ],
              "default": "over_20d",
              "output": {"n": {"$sum": 1}}
            }
          }
        ],
        "live": [
          {"$match": {"cohort": "live"}},
          {
            "$bucket": {
              "groupBy": "$T_s",
              "boundaries": [
                0,
                60,
                300,
                900,
                3600,
                21600,
                86400,
                172800,
                345600,
                604800,
                1209600,
                1728001
              ],
              "default": "over_20d",
              "output": {"n": {"$sum": 1}}
            }
          }
        ],
        "history_4d": [
          {"$match": {"cohort": "history", "T_s": {"$lte": 345600}}},
          {
            "$bucket": {
              "groupBy": "$T_s",
              "boundaries": [
                0,
                60,
                300,
                900,
                3600,
                21600,
                86400,
                172800,
                345600,
                604800,
                1209600,
                1728001
              ],
              "default": "over_20d",
              "output": {"n": {"$sum": 1}}
            }
          }
        ]
      }
    },
    {
      "$project": {
        "rows": {
          "$concatArrays": [
            {
              "$map": {
                "input": "$history",
                "in": {"cohort": "history", "bucket_lower_s": "$$this._id", "n": "$$this.n"}
              }
            },
            {
              "$map": {
                "input": "$live",
                "in": {"cohort": "live", "bucket_lower_s": "$$this._id", "n": "$$this.n"}
              }
            },
            {
              "$map": {
                "input": "$history_4d",
                "in": {"cohort": "history_4d", "bucket_lower_s": "$$this._id", "n": "$$this.n"}
              }
            }
          ]
        }
      }
    },
    {"$unwind": "$rows"},
    {"$replaceRoot": {"newRoot": "$rows"}},
    {
      "$setWindowFields": {
        "partitionBy": "$cohort",
        "sortBy": {"bucket_lower_s": 1},
        "output": {
          "total": {"$sum": "$n", "window": {"documents": ["unbounded", "unbounded"]}},
          "cum_n": {"$sum": "$n", "window": {"documents": ["unbounded", "current"]}}
        }
      }
    },
    {
      "$project": {
        "_id": 0,
        "cohort": 1,
        "bucket": {
          "$cond": [
            {"$eq": ["$bucket_lower_s", "over_20d"]},
            "over_20d",
            {
              "$arrayElemAt": [
                [
                  "<1 min",
                  "1-5 min",
                  "5-15 min",
                  "15-60 min",
                  "1-6 h",
                  "6-24 h",
                  "1-2 d",
                  "2-4 d",
                  "4-7 d",
                  "7-14 d",
                  "14-20 d"
                ],
                {
                  "$indexOfArray": [
                    [0, 60, 300, 900, 3600, 21600, 86400, 172800, 345600, 604800, 1209600, 1728001],
                    "$bucket_lower_s"
                  ]
                }
              ]
            }
          ]
        },
        "bucket_lower_s": 1,
        "bucket_order": {
          "$add": [
            {
              "$indexOfArray": [
                [0, 60, 300, 900, 3600, 21600, 86400, 172800, 345600, 604800, 1209600, 1728001],
                "$bucket_lower_s"
              ]
            },
            1
          ]
        },
        "bucket_sorted": {
          "$concat": [
            {
              "$cond": [
                {
                  "$lt": [
                    {
                      "$add": [
                        {
                          "$indexOfArray": [
                            [
                              0,
                              60,
                              300,
                              900,
                              3600,
                              21600,
                              86400,
                              172800,
                              345600,
                              604800,
                              1209600,
                              1728001
                            ],
                            "$bucket_lower_s"
                          ]
                        },
                        1
                      ]
                    },
                    10
                  ]
                },
                "0",
                ""
              ]
            },
            {
              "$toString": {
                "$add": [
                  {
                    "$indexOfArray": [
                      [
                        0,
                        60,
                        300,
                        900,
                        3600,
                        21600,
                        86400,
                        172800,
                        345600,
                        604800,
                        1209600,
                        1728001
                      ],
                      "$bucket_lower_s"
                    ]
                  },
                  1
                ]
              }
            },
            " ",
            {
              "$cond": [
                {"$eq": ["$bucket_lower_s", "over_20d"]},
                "over_20d",
                {
                  "$arrayElemAt": [
                    [
                      "<1 min",
                      "1-5 min",
                      "5-15 min",
                      "15-60 min",
                      "1-6 h",
                      "6-24 h",
                      "1-2 d",
                      "2-4 d",
                      "4-7 d",
                      "7-14 d",
                      "14-20 d"
                    ],
                    {
                      "$indexOfArray": [
                        [
                          0,
                          60,
                          300,
                          900,
                          3600,
                          21600,
                          86400,
                          172800,
                          345600,
                          604800,
                          1209600,
                          1728001
                        ],
                        "$bucket_lower_s"
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "bucket_upper_s": {
          "$arrayElemAt": [
            [0, 60, 300, 900, 3600, 21600, 86400, 172800, 345600, 604800, 1209600, 1728001],
            {
              "$add": [
                {
                  "$indexOfArray": [
                    [0, 60, 300, 900, 3600, 21600, 86400, 172800, 345600, 604800, 1209600, 1728001],
                    "$bucket_lower_s"
                  ]
                },
                1
              ]
            }
          ]
        },
        "n": 1,
        "share": {"$divide": ["$n", "$total"]},
        "cum_share": {"$divide": ["$cum_n", "$total"]}
      }
    },
    {"$sort": {"cohort": 1, "bucket_lower_s": 1}}
  ]
}
